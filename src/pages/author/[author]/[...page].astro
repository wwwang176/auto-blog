---
import List from '../../../components/List.astro';
import { getPublished } from '../../../lib/posts';
import { SITE, AUTHORS } from '../../../lib/config';
export async function getStaticPaths({ paginate }: any) {
  const all = await getPublished();
  return AUTHORS.flatMap((a) => {
    const items = all.filter((p) => p.data.author === a.id);
    return paginate(items, { pageSize: SITE.pageSize, params: { author: a.slug }, props: { author: a } })
      .map((r: any) => ({ ...r, params: { ...r.params, page: r.params.page ? `page/${r.params.page}` : undefined } }));
  });
}
const { page, author } = Astro.props;
const base = `/author/${author.slug}/`;
const url = SITE.url + base;
const suffix = page.currentPage > 1 ? `・第 ${page.currentPage} 頁` : '';
const issuesUrl = 'https://github.com/wwwang176/auto-blog/issues/new';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ProfilePage',
  url: url, name: `${author.name}｜${SITE.title}`, inLanguage: SITE.lang,
  mainEntity: {
    '@type': 'Organization', '@id': `${url}#author`, name: author.name, url,
    description: author.bio,
    parentOrganization: { '@type': 'Organization', name: SITE.title, url: SITE.url },
  },
}];
---
<List page={page} base={base} heading={`${author.name}${suffix}`} title={`${author.name}${suffix}`}
  description={author.bio} jsonLd={jsonLd} emptyText="還沒有文章。">
  {page.currentPage === 1 ? (
    <section class="about">
      <p><strong>{author.name}</strong>是 {SITE.title} 的編輯部，負責整理每天的 AI 新知、工具推薦、開源套件和新模型消息，用一般人看得懂的白話文來寫。</p>
      <h2>文章怎麼產出</h2>
      <p>本站文章是<strong>和 AI 協作產出</strong>的：由 AI 協助蒐集題材、整理資料和撰寫初稿，再經過查證、潤稿和審稿才發布。</p>
      <h2>來源怎麼查證</h2>
      <ul>
        <li>一律回到<strong>原始來源</strong>查證，例如官方公告、論文、原始程式碼庫或第一手報導。</li>
        <li>文章裡的事實都會<strong>附上引用連結</strong>，方便你自己確認。</li>
        <li>查不到可靠來源的內容<strong>不會發布</strong>，也不全文翻譯別人的文章。</li>
      </ul>
      <h2>發現錯誤？</h2>
      <p>歡迎到 <a href={issuesUrl} target="_blank" rel="noopener">GitHub Issues</a> 告訴我們（請附上文章網址和正確的來源）。確認之後會直接修正文章，並在文章上標示「更新」日期。</p>
      <h2>{author.name}的文章</h2>
    </section>
  ) : <p class="about-short">{author.bio}</p>}
</List>
<style>
.about{max-width:720px;margin:0 0 1.5rem}
.about h2{font-size:1.15rem;margin:1.4rem 0 .4rem}
.about ul{padding-left:1.2rem;margin:.3rem 0}
.about-short{color:var(--muted)}
</style>
