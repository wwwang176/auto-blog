---
import { Image } from 'astro:assets';
import { catName } from '../lib/config';
import { postUrl, fmtDate } from '../lib/posts';
// eager：列表第一張卡（LCP 元素）不要 lazy，並提高下載優先順序
const { post, eager = false } = Astro.props;
const d = post.data;
---
<div class="card">
  <a href={postUrl(d.slug)}><Image src={d.hero} alt={d.title} width={600} widths={[400, 600]}
    sizes="(max-width: 700px) calc(100vw - 2rem), 360px"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} /></a>
  <div class="body">
    <div class="meta">{fmtDate(d.date)}・{d.categories.map((c: string) => <a class="tag" href={`/category/${c}/`}>{catName(c)}</a>)}</div>
    <h2><a href={postUrl(d.slug)}>{d.title}</a></h2>
    <p>{d.description}</p>
  </div>
</div>
