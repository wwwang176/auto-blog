---
import { SITE, CATEGORIES } from '../lib/config';
interface Props {
  title?: string; description?: string; image?: string;
  ogType?: 'website' | 'article'; published?: Date; modified?: Date;
  jsonLd?: object[]; noindex?: boolean;
}
const { title, description = SITE.description, image = '/og-default.png', ogType = 'website', published, modified, jsonLd = [], noindex = false } = Astro.props;
const full = title ? `${title}｜${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ga = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang={SITE.lang}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:title" content={full} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.title} /><meta property="og:locale" content="zh_TW" />
<meta property="og:image" content={new URL(image, Astro.site)} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
<meta name="twitter:card" content="summary_large_image" />
{ga && <link rel="preconnect" href="https://www.googletagmanager.com" />}
{ga && <link rel="dns-prefetch" href="https://www.google-analytics.com" />}
{/* GA 等頁面 load 完才插入 async script，不跟首屏內容搶頻寬和 CPU；事件先排進 dataLayer，不會漏掉 pageview */}
{ga && <script is:inline define:vars={{ ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga);
function loadGA(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+ga;document.head.appendChild(s)}
if(document.readyState==='complete')loadGA();else addEventListener('load',loadGA,{once:true});</script>}
</head>
<body>
<header class="site"><div class="wrap">
  <a class="brand" href="/">{SITE.title}</a>
  <nav>{CATEGORIES.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</nav>
</div></header>
<main class="wrap"><slot /></main>
<footer class="wrap foot">© {new Date().getFullYear()} {SITE.title}・<a href="/rss.xml">RSS</a></footer>
<style is:global>
:root{--fg:#1f2328;--muted:#656d76;--bg:#fff;--line:#e5e7eb;--accent:#2563eb}
*{box-sizing:border-box}body{margin:0;font:17px/1.8 system-ui,-apple-system,"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;color:var(--fg);background:var(--bg)}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.wrap{max-width:1100px;margin:0 auto;padding:0 1rem}
header.site{border-bottom:1px solid var(--line);margin-bottom:1.5rem}
header.site .wrap{display:flex;flex-wrap:wrap;gap:.5rem 1.2rem;align-items:center;padding:.8rem 1rem}
.brand{font-weight:700;font-size:1.25rem;color:var(--fg)}nav{display:flex;flex-wrap:nowrap;gap:1rem;font-size:.95rem;overflow-x:auto;white-space:nowrap;max-width:100%;scrollbar-width:none}
/* 手機：分類選單單獨一行，可以橫向捲動；右側漸層淡出提示還有更多（mask 不影響版面，不會造成 CLS） */
@media (max-width:700px){nav{flex-basis:100%;padding-right:2rem;-webkit-mask-image:linear-gradient(to right,#000 calc(100% - 2.5rem),transparent);mask-image:linear-gradient(to right,#000 calc(100% - 2.5rem),transparent)}}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem}
.card{border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.card img{width:100%;height:auto;aspect-ratio:1200/630;object-fit:cover;display:block}
.card .body{padding:.8rem 1rem 1rem}.card h2{font-size:1.1rem;line-height:1.5;margin:.2rem 0}.card h2 a{color:var(--fg)}
.meta{color:var(--muted);font-size:.85rem}.tag{display:inline-block;margin-right:.4rem}
.card p{margin:.4rem 0 0;color:var(--muted);font-size:.95rem}
.pager{display:flex;flex-wrap:wrap;gap:.4rem;justify-content:center;margin:2rem 0}
.pager a,.pager span{padding:.3rem .75rem;border:1px solid var(--line);border-radius:6px}.pager .cur{background:var(--accent);color:#fff;border-color:var(--accent)}
article{max-width:720px;margin:0 auto}article h1{line-height:1.4}article img{max-width:100%;height:auto;border-radius:10px}
article .content{overflow-wrap:anywhere}article pre{overflow-x:auto;background:#f6f8fa;padding:1rem;border-radius:8px}
.foot{color:var(--muted);font-size:.85rem;border-top:1px solid var(--line);margin-top:3rem;padding:1.5rem 1rem}
</style>
</body></html>
